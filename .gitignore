# ---------------------------------------------------------------------------
# OPENCLASSROOMS-DataShare — .gitignore racine (monorepo)
#
# Périmètre réel du projet :
#   backend/   : application Laravel 13 (PHP 8.3 / Composer / Vite / Tailwind)
#   frontend/  : application Vue 3 + TypeScript (Vite)
#   docs/      : documentation
#   compose.yaml : Postgres 17 en local via Docker Compose
#
# Ce fichier ne couvre QUE le niveau monorepo (OS, éditeurs, secrets, Node,
# artefacts de build, Docker). Chaque application gère elle-même ses
# exclusions — backend/.gitignore, backend/database/.gitignore,
# backend/bootstrap/cache/.gitignore, backend/storage/**/.gitignore et
# frontend/.gitignore : ne pas les dupliquer ici.
# ---------------------------------------------------------------------------

# --- Systèmes d'exploitation -----------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*~
.fuse_hidden*
.Trash-*
.directory

# --- Éditeurs / IDE --------------------------------------------------------
.vscode/
!.vscode/extensions.json
.idea/
*.iml
*.code-workspace
.fleet/
.nova/
.zed/
.cursor/
.history/
.phpactor.json
.phpstorm.meta.php
_ide_helper.php
_ide_helper_models.php

# --- Environnement / secrets ----------------------------------------------
# Les fichiers d'exemple restent versionnés (cf. backend/.env.example).
.env
.env.*
!.env.example
!.env.*.example
.envrc
auth.json
*.pem
*.key
*.p12
secrets.json

# --- Node / gestionnaires de paquets --------------------------------------
node_modules/
.npm/
.yarn/
.pnp
.pnp.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Artefacts de build (frontend & assets Laravel/Vite) ------------------
# Stack frontend arrêtée (Vue 3 + Vite) : aucun dossier de framework
# supplémentaire à exclure — .next/, .nuxt/, .svelte-kit/, .angular/ sont
# sans objet ici.
dist/
build/
.vite/
.turbo/
.cache/
.parcel-cache/
*.tsbuildinfo

# --- PHP / Composer -------------------------------------------------------
# Filet de sécurité si d'autres paquets PHP apparaissent hors de backend/.
vendor/
.phpunit.result.cache
.phpunit.cache/
.php-cs-fixer.cache
.php-cs-fixer.dist.cache
.phpstan.cache/

# --- Tests & couverture ---------------------------------------------------
coverage/
.nyc_output/
clover.xml
coverage.xml
junit.xml
*.lcov

# --- Logs -----------------------------------------------------------------
*.log
logs/

# --- Docker & données locales --------------------------------------------
compose.override.yaml
compose.override.yml
docker-compose.override.yaml
docker-compose.override.yml
.docker/
# Base de données locale : dumps, volumes montés, fichiers SQLite éventuels
/data/
/dumps/
/pgdata/
*.sqlite
*.sqlite3
*.sqlite-journal
*.sql
*.sql.gz
*.dump

# --- Outils d'assistance IA (configuration locale) ------------------------
.claude/settings.local.json
.claude/local/
CLAUDE.local.md
.aider*
# Instructions générées par l'extension VS Code Mermaid Chart (réinstallables
# via « MermaidChart: Install AI Skills… ») : outillage d'éditeur, pas
# documentation projet. Ignorées nommément et non via `.github/` en entier, qui
# reste versionnable si un fichier de projet vient un jour s'y ajouter.
.github/copilot-instructions.md
.github/instructions/mermaid.instructions.md

# --- Fichiers temporaires / résidus ---------------------------------------
*.bak
*.tmp
*.orig
*.rej
*.swp
*.swo
