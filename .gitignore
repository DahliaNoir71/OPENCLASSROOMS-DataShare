# ---------------------------------------------------------------------------
# OPENCLASSROOMS-DataShare — .gitignore racine (monorepo)
#
# Périmètre réel du projet :
#   backend/   : application Laravel 12 (PHP / Composer / Vite / Tailwind)
#   frontend/  : application JS (stack à définir)
#   docs/      : documentation
#   compose.yaml : Postgres 17 en local via Docker Compose
#
# Ce fichier ne couvre QUE le niveau monorepo (OS, éditeurs, secrets, Node,
# artefacts de build, Docker). Le backend Laravel gère lui-même ses exclusions
# via backend/.gitignore, backend/database/.gitignore,
# backend/bootstrap/cache/.gitignore et backend/storage/**/.gitignore :
# ne pas les dupliquer ici.
# ---------------------------------------------------------------------------

# --- Systèmes d'exploitation -----------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*~
.fuse_hidden*
.Trash-*
.directory

# --- Éditeurs / IDE --------------------------------------------------------
.vscode/
!.vscode/extensions.json
.idea/
*.iml
*.code-workspace
.fleet/
.nova/
.zed/
.cursor/
.history/
.phpactor.json
.phpstorm.meta.php
_ide_helper.php
_ide_helper_models.php

# --- Environnement / secrets ----------------------------------------------
# Les fichiers d'exemple restent versionnés (cf. backend/.env.example).
.env
.env.*
!.env.example
!.env.*.example
.envrc
auth.json
*.pem
*.key
*.p12
secrets.json

# --- Node / gestionnaires de paquets --------------------------------------
node_modules/
.npm/
.yarn/
.pnp
.pnp.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Artefacts de build (frontend & assets Laravel/Vite) ------------------
# Compléter avec les dossiers propres au framework retenu pour frontend/
# (.next/, .nuxt/, .svelte-kit/, .angular/, …) au moment du choix de stack.
dist/
build/
.vite/
.turbo/
.cache/
.parcel-cache/
*.tsbuildinfo

# --- PHP / Composer -------------------------------------------------------
# Filet de sécurité si d'autres paquets PHP apparaissent hors de backend/.
vendor/
.phpunit.result.cache
.phpunit.cache/
.php-cs-fixer.cache
.php-cs-fixer.dist.cache
.phpstan.cache/

# --- Tests & couverture ---------------------------------------------------
coverage/
.nyc_output/
clover.xml
coverage.xml
junit.xml
*.lcov

# --- Logs -----------------------------------------------------------------
*.log
logs/

# --- Docker & données locales --------------------------------------------
compose.override.yaml
compose.override.yml
docker-compose.override.yaml
docker-compose.override.yml
.docker/
# Base de données locale : dumps, volumes montés, fichiers SQLite éventuels
/data/
/dumps/
/pgdata/
*.sqlite
*.sqlite3
*.sqlite-journal
*.sql
*.sql.gz
*.dump

# --- Outils d'assistance IA (configuration locale) ------------------------
.claude/settings.local.json
.claude/local/
CLAUDE.local.md
.aider*

# --- Fichiers temporaires / résidus ---------------------------------------
*.bak
*.tmp
*.orig
*.rej
*.swp
*.swo
